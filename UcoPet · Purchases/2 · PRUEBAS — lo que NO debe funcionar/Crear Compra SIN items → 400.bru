meta {
  name: Crear Compra SIN items → 400
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/purchases
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

script:pre-request {
  bru.setVar('purchaseNumberInvalida', 'OC-INVALIDA-' + Date.now());
}

body:json {
  {
    "purchaseNumber": "{{purchaseNumberInvalida}}",
    "supplierId": "12121212-1212-1212-1212-121212121212",
    "headquarterId": "13131313-1313-1313-1313-131313131313",
    "items": []
  }
}

script:post-response {
  test("rechaza items vacio con 400", () => expect(res.getStatus()).to.equal(400));
}

settings {
  encodeUrl: true
}
