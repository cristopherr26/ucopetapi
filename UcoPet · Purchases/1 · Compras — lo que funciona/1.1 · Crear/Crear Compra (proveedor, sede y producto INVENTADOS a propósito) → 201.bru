meta {
  name: Crear Compra (proveedor, sede y producto INVENTADOS a propósito) → 201
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/purchases
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

script:pre-request {
  bru.setVar('purchaseNumber', 'OC-' + Date.now());
}

body:json {
  {
    "purchaseNumber": "{{purchaseNumber}}",
    "supplierId": "11111111-1111-1111-1111-111111111111",
    "headquarterId": "22222222-2222-2222-2222-222222222222",
    "hasDiscount": false,
    "items": [
      {
        "productId": "33333333-3333-3333-3333-333333333333",
        "itemType": "PRODUCT",
        "quantity": 2,
        "unitPrice": 15000,
        "taxCategory": "STANDARD"
      }
    ]
  }
}

script:post-response {
  test("201 — se crea aunque proveedor, sede y producto no existan en ningun otro modulo", () =>
      expect(res.getStatus()).to.equal(201));
  const b = res.getBody();
  bru.setVar('purchaseId', b.id);
  test("id no es nulo", () => expect(b.id).to.not.be.null);
  test("queda en PENDING", () => expect(b.status).to.eql('PENDING'));
  test("supplier.name y headquarter.name son null (el modulo no los resuelve)", () => {
      expect(b.supplier.name).to.be.null;
      expect(b.headquarter.name).to.be.null;
  });
  test("items[0].catalogItem.name tambien es null", () =>
      expect(b.items[0].catalogItem.name).to.be.null);
  test("el impuesto usa el taxCategory enviado (STANDARD = 19%), no uno del catalogo", () => {
      expect(b.subtotal).to.equal(30000);
      expect(b.totalTaxes).to.equal(5700);
      expect(b.total).to.equal(35700);
  });
}

settings {
  encodeUrl: true
}

docs {
  Documenta a proposito el desacople del modulo: supplierId, headquarterId y productId no
  existen en ningun otro modulo y aun asi la compra se crea con 201. Es el comportamiento
  esperado segun ContextoModulo.md, no un hallazgo de la evaluacion.
}
