meta {
  name: Consultar Compra por ID → 200
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/purchases/{{purchaseId}}
  body: none
  auth: inherit
}

script:post-response {
  test("200 OK", () => expect(res.getStatus()).to.equal(200));
  test("el id coincide con el creado", () => expect(res.getBody().id).to.eql(bru.getVar('purchaseId')));
}

settings {
  encodeUrl: true
}
