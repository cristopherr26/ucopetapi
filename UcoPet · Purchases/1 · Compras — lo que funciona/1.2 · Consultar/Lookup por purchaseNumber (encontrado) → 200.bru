meta {
  name: Lookup por purchaseNumber (encontrado) → 200
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/purchases/lookup?purchaseNumber={{purchaseNumber}}
  body: none
  auth: inherit
}

params:query {
  purchaseNumber: {{purchaseNumber}}
}

script:post-response {
  test("200 OK", () => expect(res.getStatus()).to.equal(200));
  test("el id coincide", () => expect(res.getBody()).to.eql(bru.getVar('purchaseId')));
}

settings {
  encodeUrl: true
}
