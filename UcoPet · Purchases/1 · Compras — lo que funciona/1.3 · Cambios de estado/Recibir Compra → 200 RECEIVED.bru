meta {
  name: Recibir Compra → 200 RECEIVED
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/purchases/{{purchaseId}}/receive
  body: none
  auth: inherit
}

script:post-response {
  test("200 OK", () => expect(res.getStatus()).to.equal(200));
  test("queda en RECEIVED", () => expect(res.getBody().status).to.eql('RECEIVED'));
}

settings {
  encodeUrl: true
}
