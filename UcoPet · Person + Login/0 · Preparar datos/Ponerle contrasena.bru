meta {
  name: Ponerle contrasena
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/persons/{{anaId}}/password
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "password": "{{claveSinRol}}"
  }
}

script:post-response {
  test("204", () => expect(res.getStatus()).to.equal(204));
}

settings {
  encodeUrl: true
}
