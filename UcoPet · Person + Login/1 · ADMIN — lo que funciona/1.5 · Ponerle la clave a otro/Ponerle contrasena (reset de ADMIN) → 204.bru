meta {
  name: Ponerle contrasena (reset de ADMIN) → 204
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/persons/{{personId}}/password
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "password": "claveNuevaDePrueba"
  }
}

script:post-response {
  test("204", () => expect(res.getStatus()).to.equal(204));
}

settings {
  encodeUrl: true
}

docs {
  El paso de activacion.
}
