meta {
  name: LOGOUT · guardar el token actual
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/persons/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
  }
}

script:post-response {
  test('200', () => expect(res.getStatus()).to.equal(200));
  bru.setVar('tokenParaCerrar', res.getBody().token);
}

settings {
  encodeUrl: true
}
