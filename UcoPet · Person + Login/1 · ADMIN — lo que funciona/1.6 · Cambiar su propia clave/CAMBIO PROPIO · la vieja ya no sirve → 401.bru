meta {
  name: CAMBIO PROPIO · la vieja ya no sirve → 401
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/persons/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
  }
}

script:post-response {
  test("401", () => expect(res.getStatus()).to.equal(401));
}

settings {
  encodeUrl: true
}
