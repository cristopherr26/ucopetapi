meta {
  name: Buscar por correo
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/persons?email={{correoSinRol}}
  body: none
  auth: inherit
}

params:query {
  email: {{correoSinRol}}
}

script:post-response {
  test("200", () => expect(res.getStatus()).to.equal(200));
}

settings {
  encodeUrl: true
}
