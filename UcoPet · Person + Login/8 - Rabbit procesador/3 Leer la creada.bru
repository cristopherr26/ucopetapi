meta {
  name: Leerla → el procesador la guardo
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/persons/{{rabbitId}}
  body: none
  auth: inherit
}

script:pre-request {
  // Le da tiempo al procesador de consumir el mensaje y guardar.
  await bru.sleep(1000);
}

script:post-response {
  test("200 — si da 404, el procesador no la guardo: revisa su log", () =>
      expect(res.getStatus()).to.equal(200));
  test("el correo quedo en minusculas", () =>
      expect(res.getBody().email).to.equal(bru.getVar("rabbitCorreo").toLowerCase()));
  test("quedo activa", () => expect(res.getBody().active).to.be.true);
}

settings {
  encodeUrl: true
}