meta {
  name: Y dada de baja, tampoco → 401
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/persons/login
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{correoNuevo}}",
    "password": "claveNuevaDePrueba"
  }
}

script:post-response {
  test("401", () => expect(res.getStatus()).to.equal(401));
}

settings {
  encodeUrl: true
}
