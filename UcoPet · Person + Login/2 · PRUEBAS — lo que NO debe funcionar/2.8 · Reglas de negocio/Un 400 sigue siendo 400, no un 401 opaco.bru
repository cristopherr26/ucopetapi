meta {
  name: Un 400 sigue siendo 400, no un 401 opaco
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/persons
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {}
}

script:post-response {
  test('400 — el dispatch ERROR esta permitido a proposito', () =>
      expect(res.getStatus()).to.equal(400));
  test('y trae cuerpo, no viene vacio', () =>
      expect(res.getSize().body).to.be.above(0));
}

settings {
  encodeUrl: true
}
