meta {
  name: BUG 2b · SEGUNDA persona sin correo → 201 (daba 409)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/persons
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "documentType": "CC",
    "documentNumber": "{{docSinCorreo2}}",
    "firstName": "Sin",
    "lastName": "Correo Dos",
    "phone": "3000000000",
    "admin": false,
    "active": true,
    "address": "Calle 50 # 51-25, Rionegro"
  }
}

script:post-response {
  test("201 — varios NULL no se pisan", () => expect(res.getStatus()).to.equal(201));
  bru.setVar("sinCorreo2", res.getBody().id);
}

settings {
  encodeUrl: true
}
