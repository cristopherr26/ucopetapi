meta {
  name: deactivatedAt · el cliente no puede inventarsela
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/persons/{{anaId}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "documentType": "CC",
    "documentNumber": "{{docSinRol}}",
    "firstName": "Sin",
    "lastName": "Rol",
    "email": "{{correoSinRol}}",
    "address": "Calle 1 # 2-3, Rionegro",
    "phone": "3000000000",
    "admin": false,
    "active": true,
    "deactivatedAt": "1999-01-01T00:00:00Z"
  }
}

script:post-response {
  const b = res.getBody();
  test("200", () => expect(res.getStatus()).to.equal(200));
  test("ignoro la fecha que mande", () => expect(b.deactivatedAt).to.be.null);
  test("guardo la direccion", () =>
      expect(b.address).to.eql("Calle 1 # 2-3, Rionegro"));
}

settings {
  encodeUrl: true
}
