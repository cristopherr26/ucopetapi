meta {
  name: BUG 1b · PUT sin cambiar nada → 200 (no debe chocar consigo misma)
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/persons/{{anaId}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "documentType": "CC",
    "documentNumber": "{{docSinRol}}",
    "firstName": "Sin",
    "lastName": "Rol",
    "email": "{{correoSinRol}}",
    "address": "Calle 1 # 2-3, Rionegro",
    "phone": "3000000000",
    "admin": false,
    "active": true
  }
}

script:post-response {
  test("200", () => expect(res.getStatus()).to.equal(200));
}

settings {
  encodeUrl: true
}
