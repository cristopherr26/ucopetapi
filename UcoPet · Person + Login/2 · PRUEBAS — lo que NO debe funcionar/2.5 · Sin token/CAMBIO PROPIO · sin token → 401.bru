meta {
  name: CAMBIO PROPIO · sin token → 401
  type: http
  seq: 10
}

put {
  url: {{baseUrl}}/persons/me/password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "currentPassword": "{{adminPassword}}",
    "newPassword": "claveNueva123",
    "confirmPassword": "claveNueva123"
  }
}

script:post-response {
  test("401", () => expect(res.getStatus()).to.equal(401));
}

settings {
  encodeUrl: true
}
